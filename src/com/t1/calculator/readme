src/com/t1/calculator/
├── Main.java                    (устаревший, можно удалить)
├── CalculatorView.java          (UI компоненты)
├── CalculatorModel.java         (данные + вызов парсера)
├── CalculatorController.java    (обработчики + main)
├── ExpressionParser.java        (алгоритм вычислений)
├── ExpressionParserTest.java    (юнит-тесты)
├── HistoryService.java          (история + файлы)
├── HistoryRecord.java          (DTO для записи истории)
├── exceptions/                  
│   ├── CalculatorException.java
│   ├── DivisionByZeroException.java
│   └── InvalidExpressionException.java
└── ui/
    ├── CalculatorButton.java    (кастомная кнопка)
    └── HistoryWindow.java       (окно истории)



теперь проверим, правильно ли я понял
1. создаем класс слушатель class calculator extends JFrame implements ActionListener
2. создаем обьект слушатель  calculator c = new calculator();
3. создаем источник события b0 = new JButton("0");
4. соединяем слушателя и источник событий b0.addActionListener(c); (с это наше окно, которое при нажатии кнопки запускает метод actionPerformed)
5. пишем метод actionPerformed (ActionEvent e), который должен работать при нажатии
как работает
1. нажимаем на источник события
2. слушатель узнает о том что событие произошло благодаря addActionListener
3. запускается метод actionPerformed (ActionEvent e) в котором ActionEvent e - факт нажатия кнопки, а уже внутри метода получаем то что несет в себе кнопка благодаря String s = e.getActionCommand();

.charAt()       // получить символ по индексу
.substring()    // получить подстроку
.contains()     // проверить наличие подстроки
.replaceAll()   // заменить по regex

Pattern.compile("\\d+") // найти все числа
Matcher.matcher()       // поиск по шаблону


